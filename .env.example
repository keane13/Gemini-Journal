# =============================================================================
# Personal Gemini Journal ("Nightstand") Environment Configuration
# =============================================================================

# 1. Gemini API Key (Server-Only Secret - Never Exposed to Browser)
# In AI Studio or Cloud Run, this is automatically injected into the server container.
GEMINI_API_KEY=""

# 2. Secret Manager Configuration (Optional Cloud Run Production Setup)
GCP_PROJECT_ID=""
GCP_GEMINI_SECRET_NAME="gemini-api-key"

# 3. Application Base URL
APP_URL="http://localhost:3000"

# 4. Optional Firebase Overrides (Defaults are loaded from firebase-applet-config.json)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# =============================================================================
# FEATURE 7: Blind Admin Console (RBAC)
# =============================================================================
# Comma-separated allowlist used ONLY to bootstrap the first administrator.
# Membership alone grants nothing: the holder must still present a verified token
# whose email matches AND is email-verified, and the grant is audited.
# Leave empty in production once the first admin exists.
ADMIN_BOOTSTRAP_EMAILS=""

# Optional stable salt for the in-memory metrics uid hashing. If unset, a random
# per-process salt is generated, which is MORE private (hashes are not stable across
# restarts) but makes distinct-user counts reset on deploy. Set it only if you need
# stable daily-active-user counts across restarts.
METRICS_UID_SALT=""

# Local operator scripts (scripts/grant-admin.ts) and any non-GCP host need an explicit
# service account. On Cloud Run this is unnecessary - the metadata server supplies it.
GOOGLE_APPLICATION_CREDENTIALS=""

# =============================================================================
# FEATURE 8: Weekly Digest via Gmail
# =============================================================================
# OAuth client used ONLY for the incremental gmail.send grant.
# Create as an OAuth 2.0 Web Application client and authorize your app origin.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Cloud Scheduler OIDC verification for /api/cron/digest and /api/cron/aggregate.
# BOTH must be set or the scheduled endpoints refuse every request (fail closed).
CRON_OIDC_AUDIENCE=""
CRON_SERVICE_ACCOUNT_EMAIL=""

# LOCAL DEVELOPMENT ONLY. Never enable in production: it replaces OIDC verification
# with a shared secret sent in the x-cron-secret header.
CRON_ALLOW_SHARED_SECRET="false"
CRON_SHARED_SECRET=""

# Hosts permitted to define deep links in outgoing digest email when APP_URL is unset.
# Prevents an attacker-controlled Host header from rewriting links inside a user's email.
APP_ALLOWED_HOSTS=""

# =============================================================================
# FEATURE 9: Location Context
# =============================================================================
# SEPARATE credential from GEMINI_API_KEY. Restrict it to the Geocoding API and to
# your server's egress IPs. It is resolved server-side only and is never sent to the
# browser - the client posts coordinates and receives a place label back.
MAPS_SERVER_API_KEY=""
GCP_MAPS_SECRET_NAME="maps-geocoding-key"

# =============================================================================
# Google Cloud Secret Manager Provisioning Commands
# =============================================================================
# gcloud secrets create gemini-api-key --data-file=- --replication-policy="automatic"
# gcloud secrets add-iam-policy-binding gemini-api-key \
#     --member="serviceAccount:journal-app-sa@${PROJECT_ID}.iam.gserviceaccount.com" \
#     --role="roles/secretmanager.secretAccessor"

# =============================================================================
# Exact Cloud IAM Roles Required for Cloud Run Service Account
# =============================================================================
# 1. roles/secretmanager.secretAccessor  (Access Gemini + Maps keys in Secret Manager)
# 2. roles/datastore.user               (Read & Write Firestore user subtrees)
# 3. roles/run.invoker                  (Invoke Cloud Run service endpoints)
# 4. roles/firebaseauth.admin           (Feature 7: set role claims, suspend, revoke)
#
# The Cloud Scheduler service account additionally needs roles/run.invoker on this
# service in order to call /api/cron/digest and /api/cron/aggregate with an OIDC token.
#
# NOTE ON roles/datastore.user: this credential CAN technically read /users/**, which
# Firestore rules do not apply to. The blind-admin guarantee therefore also depends on
# the application never using it for that purpose - enforced by the code and by the
# regression test "no admin route builds a privileged read of /users". Only the audit
# ledger, aggregates, digest counters, enrollment, and Gmail token collections are ever
# accessed with it.

# =============================================================================
# EXTERNAL NOTIFICATIONS (Slack / Discord / Email)
# =============================================================================
# 32-byte base64 key used to seal Slack/Discord webhook URLs before storage.
# Webhook URLs are bearer capabilities; encrypting them means the Firestore
# credential alone is not sufficient to harvest them (TRUST_LEDGER caveat C10).
# Generate with: openssl rand -base64 32
NOTIFICATION_ENCRYPTION_KEY=""
GCP_NOTIFICATION_KEY_SECRET_NAME="notification-encryption-key"

# =============================================================================
# FEATURE 10: Adversarial Self-Test
# =============================================================================
# The synthetic tenant the cross-tenant probes target. MUST NOT be a real user's uid:
# pointing these checks at a real account would mean the security page performs the very
# attack it exists to disprove. Create a throwaway account, copy its uid here.
# When unset, the cross-tenant checks report "skipped" rather than passing.
SELFTEST_FIXTURE_UID=""

# Base URL of the published source tree, used to turn each check's covering test file
# into a clickable link (e.g. https://github.com/<owner>/<repo>/blob/main).
# When unset, the test path is still displayed, just not linked — a dead link would be
# worse than plain text on a page whose whole premise is that claims are checkable.
SELFTEST_SOURCE_BASE_URL=""

# =============================================================================
# FEATURE 11: Managed Forgetting (Cloud KMS)
# =============================================================================
# The CryptoKey that wraps each user's data encryption key. Either give the full
# resource name, or the three parts below.
#
# Grant ONLY the runtime service account roles/cloudkms.cryptoKeyEncrypterDecrypter on
# this key. No human principal should hold it: that is what makes a Firestore dump
# insufficient to read anyone's rehydration payload.
#
#   gcloud kms keyrings create journal --location=global
#   gcloud kms keys create rehydration --location=global --keyring=journal \
#       --purpose=encryption
#   gcloud kms keys add-iam-policy-binding rehydration --location=global \
#       --keyring=journal \
#       --member="serviceAccount:journal-app-sa@${PROJECT_ID}.iam.gserviceaccount.com" \
#       --role="roles/cloudkms.cryptoKeyEncrypterDecrypter"
#
# When unset, entries are still written with the redacted body as canonical, but no
# rehydration payload is stored at all -- the details are simply never recoverable.
# The app never falls back to storing the placeholder map in plaintext.
KMS_KEY_NAME=""
KMS_LOCATION="global"
KMS_KEY_RING=""
KMS_CRYPTO_KEY=""
